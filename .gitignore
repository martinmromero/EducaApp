# Ignorar el entorno virtual
.venv/
.venv_new/
venv/
venv_local/

# Ignorar archivos de caché de Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignorar la base de datos SQLite local. Antes se versionaba a propósito
# para sincronizarla entre 2 notebooks; se dejó de necesitar ese flujo y
# tenerla en git causaba que un "git checkout -- db.sqlite3" (limpieza de
# datos de prueba durante el desarrollo) pisara cambios reales hechos en
# el medio, como un reset de contraseña con changepassword.
db.sqlite3

# Cualquier otro dump/backup de sqlite (db-*.sqlite3, db_backup_*.sqlite3,
# etc.) — ya se colaron varios de estos como commits de "una vez" que
# quedaron pesando en el historial para siempre (auditoría 2026-08-10).
*.sqlite3

# Backups puntuales tipo *_backup.json (mismo motivo que arriba) — si algún
# fixture real necesita este patrón de nombre, agregar una excepción acá
# con "!nombre_real.json" en vez de sacar la regla general.
*_backup*.json

# Ignorar archivos de entorno
.env

# Ignorar archivos de VSCode
.vscode/

# Ignorar estado local de Claude Code (incluye worktrees temporales)
.claude/

# Ignorar archivos de medios subidos por usuarios (si no quieres subirlos)
# tal vez sirva no subir media, pero ahora lo comenté porque estoy con las 2 notebooks y 
#media/

# Archivos temporales del procesador de documentos (sesiones IA)
media/doc_sessions/

# Salida de "collectstatic" (STATIC_ROOT en settings.py) — se regenera
# fresca en cada deploy de Render, nunca es lo que realmente se sirve en
# producción. Estaba trackeada por error, 4MB/173 archivos quedando cada
# vez más desactualizados en cada commit (auditoría 2026-08-10).
staticfiles/

# Buffer local (JSON Lines) de corridas automáticas del monitor de Groq/visión
# antes de sincronizarse a Postgres — ver material/groq_monitor.py. Estado
# efímero de runtime, se regenera solo, nunca debe versionarse.
var/