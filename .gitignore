venv/
venv_local/

# Ignorar archivos de caché de Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignorar la base de datos SQLite local. Antes se versionaba a propósito
# para sincronizarla entre 2 notebooks; se dejó de necesitar ese flujo y
# tenerla en git causaba que un "git checkout -- db.sqlite3" (limpieza de
# datos de prueba durante el desarrollo) pisara cambios reales hechos en
# el medio, como un reset de contraseña con changepassword.
db.sqlite3

# Ignorar archivos de entorno
.env

# Ignorar archivos de VSCode
.vscode/

# Ignorar estado local de Claude Code (incluye worktrees temporales)
.claude/

# Ignorar archivos de medios subidos por usuarios (si no quieres subirlos)
