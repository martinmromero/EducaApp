# Variables de entorno de EducaApp. Copiar a .env (local) o cargar en el panel del hosting.
# Detalle de cada una y qué pasa si falta: docs/migrar_hosting.md

# --- Obligatorias ---
DATABASE_URL=postgres://usuario:clave@host:5432/base?sslmode=require
SECRET_KEY=poner-una-clave-larga-y-FIJA
DEBUG=False
# Dominios desde los que se sirve la app, separados por comas, sin esquema.
ALLOWED_HOSTS=educaapp.onrender.com
# Los mismos dominios CON esquema (https://). Sin esto el login falla con "CSRF verification failed".
CSRF_TRUSTED_ORIGINS=https://educaapp.onrender.com

# --- Recomendadas ---
# Dominio público que usan los enlaces de invitación.
PUBLIC_BASE_URL=https://educaapp.vercel.app
# Para que el paso createsuperuser --noinput del arranque cree la cuenta admin.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@ejemplo.com
DJANGO_SUPERUSER_PASSWORD=cambiar

# --- Opcionales ---
# 0 apaga el buscador de materias.
SELECTORES_INTELIGENTES=1
# Solo para la pantalla de uso de Neon en Administración (no se usan para conectarse).
NEON_API_KEY=
NEON_PROJECT_ID=
